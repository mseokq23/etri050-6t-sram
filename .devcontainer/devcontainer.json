// IIC-OSIC-TOOLS + noVNC desktop for the ETRI 0.5 um (MyChip) 6T SRAM guide
{
  "name": "etri050-6t-sram (IIC-OSIC-TOOLS 2026.10)",

  // devcontainer variant of IIC-OSIC-TOOLS (user "designer"), pinned so the tool versions stay the same
  "image": "hpretl/iic-osic-tools-devcontainer:2026.10",

  // 2-core works, 4-core is more comfortable for the desktop
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },

  "containerEnv": {
    "NO_VNC_PORT": "6080",
    "XKB_KEYBOARD_LAYOUT": "us",
    "XKB_KEYBOARD_VARIANT": "",
    "TZ": "Asia/Seoul"
  },

  // GUI programs started from a VS Code terminal open on the noVNC desktop
  "remoteEnv": { "DISPLAY": ":1" },

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "EDA Desktop (noVNC)", "onAutoForward": "openBrowserOnce" }
  },

  // once: download the ETRI design kit from its own repository (it is not stored here)
  "postCreateCommand": "bash scripts/setup-etri050.sh",
  // every start: Xvnc + XFCE + noVNC
  "postStartCommand": "bash .devcontainer/start-desktop.sh",

  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
